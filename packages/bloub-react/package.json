{
  "name": "bloub-react",
  "version": "0.1.0",
  "description": "React component library for the animated bloub SVG avatar",
  "keywords": [
    "bloub",
    "react",
    "avatar",
    "svg",
    "animation",
    "component"
  ],
  "homepage": "https://github.com/ShunquanWang/bloub-react",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShunquanWang/bloub-react.git",
    "directory": "packages/bloub-react"
  },
  "bugs": {
    "url": "https://github.com/ShunquanWang/bloub-react/issues"
  },
  "author": {
    "name": "Shunquan Wang",
    "url": "https://github.com/ShunquanWang"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "types": "./src/index.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md",
    "package.json"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p ./tsconfig.build.json && tsup --config ./tsup.config.ts",
    "clean": "rimraf --no-glob ./dist ./coverage ./tsconfig.tsbuildinfo ./dist-test-dts",
    "lint": "eslint .",
    "test": "run-s test-unit",
    "test-unit": "vitest run",
    "test-coverage": "vitest run --coverage",
    "test-unit-watch": "vitest watch --ui",
    "typecheck": "tsc --project ./tsconfig.json --noEmit",
    "prepublishOnly": "yarn build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@hyperse/eslint-config-hyperse": "^1.7.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-istanbul": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "eslint": "^10.2.1",
    "jsdom": "29.0.2",
    "npm-run-all": "4.1.5",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
