{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "incremental": false,
    "moduleResolution": "bundler",
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "ignoreDeprecations": "6.0",
    "paths": {},
    "types": ["@types/node", "@types/react", "@types/react-dom"]
  },
  "include": ["./src/**/*.ts", "./src/**/*.tsx"],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.stories.tsx",
    "**/*.stories.mdx",
    ".storybook/**",
    "dist",
    "node_modules",
    "backup"
  ]
}
